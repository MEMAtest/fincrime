# Database (Hetzner PostgreSQL)
DATABASE_URL=postgresql://fincrime_app:PASSWORD@89.167.95.173:5432/fincrime_lab?sslmode=require

# Groq AI
GROQ_API_KEY=gsk_xxxxxxxxxxxxx
GROQ_MODEL=llama-3.3-70b-versatile

# AWS SES (eu-west-2)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SES_REGION=eu-west-2
FROM_EMAIL=noreply@memaconsultants.com
FROM_NAME=MEMA FinCrime Lab

# Notification digests (see .github/workflows/notifications.yml)
# CRON_SECRET must be set here (Vercel env, production) AND as the repo
# secret CRON_SECRET the workflow sends as `Authorization: Bearer ...` -
# the two are compared with timingSafeEqual by app/api/notifications/run.
CRON_SECRET=
# Absolute base URL used to build links inside notification emails (the
# governance portfolio's item hrefs are relative). Defaults to the
# production URL if unset.
APP_BASE_URL=https://fincrime.memaconsultants.com

# Optional
PG_CONNECTION_TIMEOUT_MS=5000
PG_QUERY_TIMEOUT_MS=8000
PG_STATEMENT_TIMEOUT_MS=8000
PG_IDLE_TIMEOUT_MS=10000
