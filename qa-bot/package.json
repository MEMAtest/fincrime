{
  "name": "qabot",
  "version": "0.1.0",
  "description": "Universal QA bot: point it at any URL or codebase and it hunts for UI, UX, accessibility, backend and code-health bugs",
  "type": "module",
  "bin": {
    "qabot": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p .",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc -p . --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "axe-core": "^4.13.0",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.56.1",
    "pngjs": "^7.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
